# Official TypeSafe Jev API (required to run the pilot).
# Create a key at https://console.typesafe.ai/keys
# The official Python SDK reads this variable.
TYPESAFE_API_KEY=

# Optional. Default is jev-latest (official alias). Pin a version such as
# jev-1.13.0 if you need a frozen resolved-model string for go/no-go.
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Only needed if anonymous Hugging Face downloads are rate-limited.
# The BTZSC dataset (https://huggingface.co/datasets/btzsc/btzsc) is public.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=
